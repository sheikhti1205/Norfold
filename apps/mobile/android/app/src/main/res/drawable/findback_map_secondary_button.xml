<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/findback_map_control_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/findback_map_surface_container" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/findback_map_divider" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/findback_map_surface_low" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/findback_map_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/findback_map_surface_low" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/findback_map_divider" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
